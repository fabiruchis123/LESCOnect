# =============================================================================
# LESCOnect — Configuración del Gateway Local de OTPs ($0 Costo)
# =============================================================================

# Puerto del servidor local
PORT=3001

# Clave secreta para proteger los endpoints (Bearer Token)
API_SECRET=clave-secreta-lesconect-2026

# Modo de operación:
# - 'sim_sms': Envío prioritario por SIM física usando un celular Android con chip Kölbi/Claro/Liberty.
# - 'whatsapp': Envío por WhatsApp personal mediante escaneo de código QR (Baileys).
# - 'hybrid': Intenta primero por SIM física; si falla o no está conectada, despacha por WhatsApp; si no, consola.
# - 'console': No envía a hardware; imprime los códigos con formato en la terminal.
GATEWAY_MODE=hybrid

# -----------------------------------------------------------------------------
# CONFIGURACIÓN DE PASARELA CON SIM FÍSICA ANDROID (Capcom6 SMS Gateway)
# -----------------------------------------------------------------------------
# Dirección IP local o URL pública del celular Android que tiene la SIM física insertada.
# Ejemplo en red local Wi-Fi: http://192.168.1.150:8080
# Ejemplo con túnel Cloudflare: https://sms-gateway-propio.trycloudflare.com
SIM_GATEWAY_URL=http://192.168.1.150:8080

# Credenciales configuradas en la app Android (Ajustes > Basic Auth)
SIM_GATEWAY_USER=lesconect
SIM_GATEWAY_PASSWORD=cambia_esta_clave_segura

# Tiempo máximo de espera en milisegundos para que el celular procese la solicitud
SIM_GATEWAY_TIMEOUT_MS=8000
