{
  "expo": {
    "name": "LESCOnect",
    "slug": "LESCOnect",
    "scheme": "lesconect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LESCOnect-Logo-manos.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/LESCOnect-Logo-manos.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBF6EE"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF6EE",
        "foregroundImage": "./assets/LESCOnect-Logo-manos.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/LESCOnect-Logo-manos.png",
      "name": "LESCOnect — Puente de comunicación e inclusión",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar"
    ]
  }
}
